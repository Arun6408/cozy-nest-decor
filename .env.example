# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# Optional. Leave empty on Vercel: the site uses your *.vercel.app domain
# automatically. Set it when you move to a custom domain.
NEXT_PUBLIC_SITE_URL=

# Pinterest "Claim website" → HTML tag → the content="..." value only
NEXT_PUBLIC_PINTEREST_VERIFY=

# Shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=

# Affiliate tracking. Leave empty until each program approves you.
NEXT_PUBLIC_AMAZON_TAG=
NEXT_PUBLIC_AWIN_AFFID=
NEXT_PUBLIC_AWIN_ETSY_MID=
